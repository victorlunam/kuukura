---
// Deploy targets (docs/deploy.md) and the last three commands of the README quickstart for Docker Compose + Caddy,
// verbatim; the full steps are in the guide.
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import Window from '../ui/Window.astro';
import CodeBlock from '../ui/CodeBlock.astro';

const targets = [
  { name: 'Docker Compose + Caddy', href: '/docs/templates/#docker-compose--caddy-any-vps' },
  { name: 'Dokploy', href: '/docs/templates/#dokploy-compose' },
  { name: 'Coolify', href: '/docs/templates/#coolify' },
  { name: 'Render', href: '/docs/templates/#render' },
  { name: 'Docker Swarm', href: '/docs/templates/#docker-swarm--portainer-stack' },
  { name: 'docker run', href: '/docs/deploy/#deploy-targets' },
];
const quickstart = `# with the compose file, .env and a master key in place (see the guide):
docker compose up -d
docker compose exec kuukura /ku-server user invite you@example.com --admin
docker compose exec -it kuukura /ku-server key show`;
---

<Section id="deploy" aria-labelledby="deploy-title" inner="deploy-grid">
  <div>
    <Heading id="deploy-title" eyebrow="Deploy" gap={false}>
      Runs anywhere you run Docker.
      <Fragment slot="lede">
        One container and the published image. <b>SQLite by default</b>, Postgres when you want it. Nothing to compile.
      </Fragment>
    </Heading>
    <ul class="targets" aria-label="Templates">
      {
        targets.map((t) => (
          <li>
            <a href={t.href}>{t.name}</a>
          </li>
        ))
      }
    </ul>
    <p class="more"><ArrowLink href="/docs/deploy/">Read the deploy guide</ArrowLink></p>
  </div>
  <Window title="Docker Compose + Caddy, on any VPS" chrome="code" data-reveal>
    <CodeBlock code={quickstart} label="Deploy commands" size="sm" />
    <Fragment slot="footer">
      Back up the master key right away: without it nobody, including the maintainer, can read your data.{' '}
      <a href="/docs/deploy/">The full steps</a>
    </Fragment>
  </Window>
</Section>

<style>
  :global(.deploy-grid) {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }
  /* text badges for the platforms: names only, no third-party logos */
  .targets {
    list-style: none;
    margin: var(--k-space-6) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .targets a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--k-radius-pill);
    border: 1px solid var(--k-line);
    background: var(--k-card);
    color: var(--k-ink);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: border-color var(--k-dur) ease;
  }
  .targets a:hover {
    border-color: var(--k-line-3);
  }
  .more {
    margin: var(--k-space-5) 0 0;
  }
  @media (max-width: 900px) {
    :global(.deploy-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

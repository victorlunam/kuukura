---
// A real session, typed as you scroll: each caption drives its lines. Commands and output are the CLI's own
// (cmd/ku); the URL and names are the docs' fake examples, and the value never appears: the prompt echoes bullets.
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Window from '../ui/Window.astro';

type Line = { k: 'cmd' | 'cont' | 'ok' | 'out'; text: string };
const steps: { title: string; body: string; lines: Line[] }[] = [
  {
    title: 'Point it at your server.',
    body: 'A profile is a name and the address of your vault. Nothing secret is stored in it.',
    lines: [
      { k: 'cmd', text: 'ku profile add work \\' },
      { k: 'cont', text: '    --url https://vault.example.com' },
      { k: 'ok', text: 'Added profile work' },
    ],
  },
  {
    title: 'Sign in with Google, then your passkey.',
    body: 'A passkey or authenticator app is required on every sign-in. The session is kept in your system keychain for 8 hours, 1 hour idle.',
    lines: [
      { k: 'cmd', text: 'ku login' },
      { k: 'out', text: 'profile: work' },
      { k: 'out', text: 'Opening your browser to sign in.' },
      { k: 'ok', text: 'Signed in to work' },
    ],
  },
  {
    title: 'Save a value. Never as an argument.',
    body: 'It comes from a hidden prompt, so it stays out of your shell history and the process list. The server encrypts it under a fresh data key.',
    lines: [
      { k: 'cmd', text: 'ku secret set DATABASE_URL app:shop' },
      { k: 'out', text: 'Value (hidden): ••••••••••••••••' },
      { k: 'out', text: 'DATABASE_URL is new. Create it? (y/N) y' },
      { k: 'ok', text: 'Saved DATABASE_URL (version 1)' },
    ],
  },
  {
    title: 'Run your app with its secrets.',
    body: 'Link the folder to an app once. ku run starts your command with the secrets you may read in its environment, and passes its output and exit code through.',
    lines: [
      { k: 'cmd', text: 'ku link shop' },
      { k: 'ok', text: 'Linked this folder to shop' },
      { k: 'cmd', text: 'ku run -- npm start' },
      { k: 'out', text: '> shop@1.0.0 start' },
      { k: 'out', text: '> node server.js' },
      { k: 'out', text: 'listening on :3000' },
    ],
  },
];

// Each step's lines are spread over the middle of its caption's pass through the viewport, weighted by length.
const START = 38;
const END = 58;
const lines = steps.flatMap((step, si) => {
  const typed = (l: Line) => l.k === 'cmd' || l.k === 'cont';
  const weight = step.lines.map((l) => (typed(l) ? l.text.length : 6));
  const total = weight.reduce((a, b) => a + b, 0);
  let at = START;
  return step.lines.map((l, i) => {
    const r0 = at;
    at += ((END - START) * (weight[i] ?? 0)) / total;
    return { ...l, typed: typed(l), style: `--tl: --s${si + 1}; --r0: ${r0.toFixed(2)}%; --r1: ${at.toFixed(2)}%; --n: ${l.text.length}`, step: si + 1 };
  });
});
---

<Section class="session" aria-labelledby="session-title">
  <Heading id="session-title" eyebrow="Five commands">Hand a secret to a program without handing it to a person.</Heading>
  <div class="scene" data-steps>
    <div class="captions">
      {
        steps.map((s, i) => (
          <div class="caption" data-step-caption={i + 1} style={`view-timeline-name: --s${i + 1}; --cap: --s${i + 1}`}>
            <p class="n">
              <span class="sr-only">Step </span>
              {`${i + 1}`}
              <span aria-hidden="true">{' / 4'}</span>
            </p>
            <h3 data-focus>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))
      }
    </div>
    <div class="term">
      <Window title="~/shop" aria-label="A terminal session: add a profile, sign in, save a secret, run an app">
        <pre><code>{lines.map((l) => (
          <span class:list={['ln', l.k]} data-line data-step={l.step} data-command={l.k === 'cmd' ? '' : undefined} style={l.style}>{l.k === 'cmd' ? <span class="ps">$ </span> : null}{l.k === 'ok' ? <span class="check">✓ </span> : null}<span class="tx">{l.text}{l.typed ? <span data-caret aria-hidden="true" /> : null}</span>{'\n'}</span>
        ))}<span class="ln end" data-line data-step="4" style="--tl: --s4; --r0: 59%"><span class="ps">$ </span><span class="cursor" data-blink aria-hidden="true"></span></span></code></pre>
      </Window>
    </div>
  </div>
</Section>

<style>
  .session {
    padding-bottom: calc(var(--k-section) * 0.6);
  }
  .scene {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    timeline-scope: --s1, --s2, --s3, --s4;
  }
  .captions {
    padding-block: 4vh 12vh;
  }
  .caption {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 26rem;
  }
  .n {
    margin: 0 0 var(--k-space-3);
    font: 600 var(--k-text-sm) / 1 var(--k-mono);
    color: var(--k-muted);
  }
  .n span[aria-hidden] {
    color: var(--k-ink-2);
  }
  h3 {
    margin: 0;
    font-size: clamp(1.625rem, 1.1rem + 1.6vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .caption p:last-child {
    margin: var(--k-space-4) 0 0;
    color: var(--k-muted);
  }
  .term > :global(figure) {
    position: sticky;
    top: max(5rem, calc(50vh - 16.5rem));
    margin-top: 4vh;
  }
  /* the terminal's text */
  pre {
    margin: 0;
    padding: 1.25rem 1.4rem 1.5rem;
    font: 400 clamp(0.72rem, 0.55rem + 0.55vw, 0.95rem) / 1.75 var(--k-mono);
    color: var(--k-ink);
    white-space: pre;
    overflow: hidden;
  }
  .ln {
    display: block;
  }
  .ln.cmd:not(:first-child),
  .ln.end {
    margin-top: 0.7em;
  }
  .ps {
    color: var(--k-amber);
  }
  .check {
    color: var(--k-acc);
  }
  .ln.out {
    color: var(--k-muted);
  }
  .tx {
    position: relative;
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: -0.2em;
    background: var(--k-ink);
    opacity: 0.85;
  }
  @media (max-width: 900px) {
    .scene {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .term {
      order: -1;
      position: sticky;
      top: 4.25rem;
      z-index: 2;
    }
    .term > :global(figure) {
      position: static;
      margin-top: 0;
    }
    /* the captions scroll under the terminal: a solid band above it, a fade below it */
    .term::before {
      content: '';
      position: absolute;
      inset: -4.25rem 0 0;
      z-index: -1;
      background: var(--k-bg);
    }
    .term::after {
      content: '';
      position: absolute;
      inset: auto 0 -2.5rem;
      height: 2.5rem;
      background: linear-gradient(var(--k-bg), transparent);
    }
    .captions {
      padding-block: 2rem 20vh;
    }
    .caption {
      min-height: 58vh;
      justify-content: flex-start;
      padding-top: 2rem;
      view-timeline-inset: 45vh 0;
    }
    pre {
      line-height: 1.6;
      padding: 1rem 1rem 1.1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caption {
      min-height: 0;
      padding-block: 2rem;
    }
    .captions {
      padding-block: 0;
    }
  }
</style>

---
// README "How it works", drawn: clients -> TLS -> ku-server (authorize, decrypt, audit) -> the database, with the
// master key, Google and the confirmation factor around it. Two drawings of one graph: wide, and tall for phones.
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';

type Box = { x: number; y: number; w: number; h: number; title: string; sub?: string[]; at: number };
type Label = { x: number; y: number; t: string; anchor?: string };

const wide = {
  vb: '0 0 1120 600',
  clients: [
    { x: 24, y: 90, w: 232, h: 86, title: 'ku (CLI)', sub: ['people'], at: 4 },
    { x: 24, y: 250, w: 232, h: 86, title: 'CI job', sub: ['machine token'], at: 8 },
    { x: 24, y: 410, w: 232, h: 86, title: 'AI agent', sub: ['through ku run'], at: 12 },
  ] as Box[],
  tls: ['M256 133 C350 133 342 263 436 263', 'M256 293 C340 293 352 303 436 303', 'M256 453 C350 453 342 343 436 343'],
  tlsLabel: { x: 346, y: 303 },
  server: { x: 436, y: 188, w: 268, h: 230 },
  pills: [
    { y: 252, a: 'authorize', b: 'grants per tag' },
    { y: 304, a: 'decrypt', b: 'key per version' },
    { y: 356, a: 'audit', b: 'hash chain' },
  ],
  pillX: 460,
  pillW: 220,
  pillH: 40,
  db: { x: 868, y: 244, w: 228, h: 118, title: 'SQLite or Postgres', sub: ['ciphertext and', 'wrapped keys only'], at: 34 } as Box,
  dbLine: 'M704 303 L868 303',
  key: { x: 456, y: 506, w: 228, h: 78, title: 'Master key', sub: ['file, env var or AWS KMS'], at: 40 } as Box,
  keyLine: 'M570 506 L570 418',
  google: { x: 456, y: 22, w: 228, h: 78, title: 'Google', sub: ['sign-in only'], at: 46 } as Box,
  googleLine: 'M570 100 L570 188',
  factor: { x: 868, y: 22, w: 228, h: 96, title: 'Your passkey', sub: ['or authenticator app,', 'for confirmations'], at: 50 } as Box,
  factorLine: 'M704 226 C792 226 790 70 868 70',
  labels: [
    { x: 786, y: 292, t: 'reads and writes' },
    { x: 582, y: 470, t: 'wraps the data keys', anchor: 'start' },
  ] as Label[],
  font: { title: 18, sub: 14, pill: 15, pillSub: 12.5 },
};

const tall = {
  vb: '0 0 360 800',
  clients: [
    { x: 6, y: 12, w: 110, h: 70, title: 'ku (CLI)', sub: ['people'], at: 4 },
    { x: 125, y: 12, w: 110, h: 70, title: 'CI job', sub: ['machine token'], at: 8 },
    { x: 244, y: 12, w: 110, h: 70, title: 'AI agent', sub: ['via ku run'], at: 12 },
  ] as Box[],
  tls: ['M61 82 C61 130 140 124 140 170', 'M180 82 L180 170', 'M299 82 C299 130 220 124 220 170'],
  tlsLabel: { x: 180, y: 128 },
  server: { x: 30, y: 170, w: 300, h: 214 },
  pills: [
    { y: 224, a: 'authorize', b: 'grants' },
    { y: 272, a: 'decrypt', b: 'data keys' },
    { y: 320, a: 'audit', b: 'hash chain' },
  ],
  pillX: 52,
  pillW: 256,
  pillH: 36,
  db: { x: 6, y: 470, w: 164, h: 120, title: 'SQLite or Postgres', sub: ['ciphertext and', 'wrapped keys only'], at: 34 } as Box,
  dbLine: 'M88 384 L88 470',
  key: { x: 190, y: 470, w: 164, h: 120, title: 'Master key', sub: ['file, env var', 'or AWS KMS'], at: 40 } as Box,
  keyLine: 'M272 470 L272 384',
  google: { x: 6, y: 700, w: 164, h: 88, title: 'Google', sub: ['sign-in only'], at: 46 } as Box,
  googleLine: 'M180 384 L180 650 L88 650 L88 700',
  factor: { x: 190, y: 700, w: 164, h: 88, title: 'Your passkey', sub: ['or authenticator', 'app: confirmations'], at: 50 } as Box,
  factorLine: 'M180 650 L272 650 L272 700',
  labels: [] as Label[],
  font: { title: 14, sub: 11.5, pill: 13, pillSub: 11 },
};

const range = (a: number, b: number) => `--a: ${a}%; --b: ${b}%`;
const notes = [
  ['Envelope encryption.', 'A fresh AES-256-GCM data key for every secret version.'],
  ['The master key is not in the database.', 'A file or Docker secret, an environment variable, or AWS KMS.'],
  ['No unseal step.', 'The server reads the key at start and refuses a key that cannot open the data.'],
];
---

<Section id="how" aria-labelledby="how-title">
  <Heading id="how-title" eyebrow="How it works" align="center">
    The CLI is a channel.<br />The server holds the keys.
    <Fragment slot="lede">
      Your server checks the grant, decrypts, and writes the decision to the audit log. The database only ever holds
      ciphertext and wrapped keys.
    </Fragment>
  </Heading>

  <figure class="diagram" data-draw-root>
    {
      [
        { name: 'wide', d: wide },
        { name: 'tall', d: tall },
      ].map(({ name, d }) => {
        const f = d.font;
        const box = (b: Box, kind = '') => (
          <g class:list={['node', kind]} data-draw="fade" style={range(b.at, b.at + 10)}>
            <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="18" />
            <text x={b.x + 20} y={b.y + 22 + f.title} class="t" font-size={f.title}>
              {b.title}
            </text>
            {(b.sub ?? []).map((s, i) => (
              <text x={b.x + 20} y={b.y + 26 + f.title + (i + 1) * (f.sub + 6)} class="s" font-size={f.sub}>
                {s}
              </text>
            ))}
          </g>
        );
        const arrow = `url(#arrow-${name})`;
        return (
          <svg class={name} viewBox={d.vb} role="img" aria-labelledby={`diagram-${name}`}>
            <title id={`diagram-${name}`}>
              The ku CLI, CI jobs and AI agents talk to ku-server over TLS. The server authorizes, decrypts and audits.
              The database, SQLite or Postgres, holds only ciphertext and wrapped keys. The master key comes from a
              file, an environment variable or AWS KMS. Google is used for sign-in only, and confirmations use your
              passkey or authenticator app.
            </title>
            <defs>
              <marker id={`arrow-${name}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M1 1 L9 5 L1 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </marker>
            </defs>

            {d.tls.map((p, i) => (
              <path id={`tls-${name}-${i}`} class="line" d={p} pathLength="1" data-draw="line" style={range(16 + i * 3, 30 + i * 3)} marker-end={arrow} />
            ))}
            <g class="node" data-draw="fade" style={range(24, 32)}>
              <rect class="pill" x={d.tlsLabel.x - 24} y={d.tlsLabel.y - 13} width="48" height="26" rx="13" />
              <text x={d.tlsLabel.x} y={d.tlsLabel.y + 4.5} class="tag" text-anchor="middle" font-size="12.5">
                TLS
              </text>
            </g>
            <path class="line" d={d.dbLine} pathLength="1" data-draw="line" style={range(32, 42)} marker-end={arrow} marker-start={arrow} />
            <path class="line" d={d.keyLine} pathLength="1" data-draw="line" style={range(40, 48)} marker-end={arrow} />
            <path class="dash" d={d.googleLine} data-draw="fade" style={range(46, 54)} />
            <path class="dash" d={d.factorLine} data-draw="fade" style={range(50, 58)} />
            {d.labels.map((l) => (
              <text x={l.x} y={l.y} class="s" data-draw="fade" style={range(40, 50)} text-anchor={l.anchor ?? 'middle'} font-size={f.sub - 1}>
                {l.t}
              </text>
            ))}

            {d.clients.map((c) => box(c))}

            <g class="node server" data-draw="fade" style={range(12, 24)}>
              <rect x={d.server.x} y={d.server.y} width={d.server.w} height={d.server.h} rx="22" />
              <text x={d.server.x + 24} y={d.server.y + 24 + f.title} class="t" font-size={f.title + 2}>
                ku-server
              </text>
              <text x={d.server.x + d.server.w - 24} y={d.server.y + 24 + f.title} class="s" text-anchor="end" font-size={f.sub}>
                your host
              </text>
            </g>
            {d.pills.map((p, i) => (
              <g class="node" data-draw="fade" style={range(20 + i * 4, 28 + i * 4)}>
                <rect class="pill" x={d.pillX} y={p.y} width={d.pillW} height={d.pillH} rx="12" />
                <circle cx={d.pillX + 18} cy={p.y + d.pillH / 2} r="4" class="dot" />
                <text x={d.pillX + 32} y={p.y + d.pillH / 2 + 5} class="t" font-size={f.pill}>
                  {p.a}
                </text>
                <text x={d.pillX + d.pillW - 14} y={p.y + d.pillH / 2 + 5} class="s" text-anchor="end" font-size={f.pillSub}>
                  {p.b}
                </text>
              </g>
            ))}

            {box(d.db, 'db')}
            {box(d.key, 'key')}
            {box(d.google, 'ext')}
            {box(d.factor, 'ext')}

            <g data-packets aria-hidden="true">
              {d.tls.map((_, i) => (
                <circle r="4" class="packet">
                  <animateMotion dur={`${2.6 + i * 0.4}s`} begin={`${i * 0.7}s`} repeatCount="indefinite">
                    <mpath href={`#tls-${name}-${i}`} />
                  </animateMotion>
                </circle>
              ))}
            </g>
          </svg>
        );
      })
    }
  </figure>

  <ul class="notes">{notes.map(([a, b]) => <li><b>{a}</b> {b}</li>)}</ul>
</Section>

<style>
  .diagram {
    margin: 0 auto;
    max-width: 70rem;
    color: var(--k-line-3);
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--k-font);
  }
  .tall {
    display: none;
    max-width: 26rem;
    margin-inline: auto;
  }
  @media (max-width: 760px) {
    .wide {
      display: none;
    }
    .tall {
      display: block;
    }
  }
  /* the drawing's own colors, all from the tokens */
  .node rect {
    fill: var(--k-card);
    stroke: var(--k-line);
    stroke-width: 1.5;
  }
  .server > rect {
    fill: #0b2025;
    stroke: var(--k-line-2);
    stroke-width: 2;
  }
  .node .pill {
    fill: var(--k-soft-2);
    stroke: var(--k-line);
  }
  .db rect {
    stroke: var(--k-line-2);
  }
  .key rect {
    stroke: rgba(251, 191, 36, 0.45); /* the amber, quietly: the one key */
  }
  .ext rect {
    fill: transparent;
    stroke-dasharray: 5 6;
  }
  .t {
    fill: var(--k-ink);
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .s {
    fill: var(--k-muted);
  }
  .tag {
    fill: var(--k-ink);
    font-weight: 650;
    font-family: var(--k-mono);
  }
  .dot,
  .packet {
    fill: var(--k-acc);
  }
  .line,
  .dash {
    fill: none;
    stroke: var(--k-line-3);
    stroke-linecap: round;
  }
  .line {
    stroke-width: 2;
  }
  .dash {
    stroke-width: 1.75;
    stroke-dasharray: 2 7;
  }
  /* layout */
  .notes {
    list-style: none;
    margin: var(--k-space-8) auto 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    max-width: 70rem;
    color: var(--k-muted);
    font-size: 1rem;
  }
  .notes li {
    border-top: 1px solid var(--k-line);
    padding-top: 1.25rem;
  }
  .notes b {
    display: block;
    margin-bottom: var(--k-space-1);
  }
  @media (max-width: 900px) {
    .notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

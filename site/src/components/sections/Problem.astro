---
// The problem in a few big lines (README "Why kuukura"), then the answer.
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Lede from '../ui/Lede.astro';
---

<Section aria-labelledby="problem-title">
  <Eyebrow id="problem-title">Why kuukura</Eyebrow>
  <div class="lines">
    <p data-dim><code>.env</code> files passed around in chat.</p>
    <p data-dim>API keys in a shared password manager.</p>
    <p data-dim>A heavyweight vault with seal, unseal and a policy language.</p>
    <p data-dim>And nobody can say who read what last week.</p>
  </div>
  <p class="answer k-quiet" data-reveal>
    kuukura is one small server, one database and three ideas:{' '}
    <span>tags, grants and people.</span>
  </p>
  <Lede data-reveal>You run it, you hold the keys, and every read lands in a tamper-evident log.</Lede>
</Section>

<style>
  .lines,
  .answer {
    font-size: clamp(2rem, 0.9rem + 4.4vw, 4.25rem);
    line-height: 1.08;
    letter-spacing: var(--k-tracking-tight);
    font-weight: 700;
  }
  .lines {
    display: grid;
    gap: 0.15em;
  }
  p {
    margin: 0;
    text-wrap: balance;
  }
  .lines code {
    font: inherit;
    color: var(--k-amber);
  }
  .answer {
    margin-top: clamp(4rem, 10vw, 8rem);
    max-width: 54rem;
  }
  .answer span {
    color: var(--k-ink);
  }
</style>

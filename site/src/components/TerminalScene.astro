---
// A real session, typed as you scroll. Commands and output lines are the CLI's own (cmd/ku); the URL and names are
// the docs' fake examples, and the value never appears: the prompt echoes bullets.
type Line = { k: 'cmd' | 'cont' | 'ok' | 'out' | 'dim'; text: string };
type Step = { title: string; body: string; lines: Line[] };

const steps: Step[] = [
  {
    title: 'Point it at your server.',
    body: 'A profile is a name and the address of your vault. Nothing secret is stored in it.',
    lines: [
      { k: 'cmd', text: 'ku profile add work \\' },
      { k: 'cont', text: '    --url https://vault.example.com' },
      { k: 'ok', text: 'Added profile work' },
    ],
  },
  {
    title: 'Sign in with Google, then your passkey.',
    body: 'A passkey or authenticator app is required on every sign-in. The session lives in your system keychain for 8 hours, 1 hour idle.',
    lines: [
      { k: 'cmd', text: 'ku login' },
      { k: 'dim', text: 'profile: work' },
      { k: 'dim', text: 'Opening your browser to sign in.' },
      { k: 'ok', text: 'Signed in to work' },
    ],
  },
  {
    title: 'Save a value. Never as an argument.',
    body: 'It comes from a hidden prompt, so it stays out of your shell history and the process list. The server encrypts it under a fresh data key.',
    lines: [
      { k: 'cmd', text: 'ku secret set DATABASE_URL app:shop' },
      { k: 'dim', text: 'Value (hidden): ••••••••••••••••' },
      { k: 'dim', text: 'DATABASE_URL is new. Create it? (y/N) y' },
      { k: 'ok', text: 'Saved DATABASE_URL (version 1)' },
    ],
  },
  {
    title: 'Run your app with its secrets.',
    body: 'Link the folder to an app once. ku run starts your command with the secrets you may read in its environment, and passes its output and exit code through.',
    lines: [
      { k: 'cmd', text: 'ku link shop' },
      { k: 'ok', text: 'Linked this folder to shop' },
      { k: 'cmd', text: 'ku run -- npm start' },
      { k: 'out', text: '> shop@1.0.0 start' },
      { k: 'out', text: '> node server.js' },
      { k: 'out', text: 'listening on :3000' },
    ],
  },
];

// Spread each step's lines over the middle of its caption's pass through the viewport, weighted by length.
const START = 38;
const END = 58;
const timed = steps.map((step, si) => {
  const weight = step.lines.map((l) => (l.k === 'cmd' || l.k === 'cont' ? l.text.length : 6));
  const total = weight.reduce((a, b) => a + b, 0);
  let at = START;
  return step.lines.map((l, i) => {
    const span = ((END - START) * (weight[i] ?? 0)) / total;
    const r0 = at;
    at += span;
    return { ...l, s: si + 1, r0: +r0.toFixed(2), r1: +at.toFixed(2), n: l.text.length };
  });
});
---

<div class="scene">
  <div class="scene-captions">
    {
      steps.map((s, i) => (
        <div class="cap" data-step={i + 1} style={`view-timeline-name: --s${i + 1}; --cap: --s${i + 1}`}>
          <p class="cap-n">
            <span class="sr-only">Step </span>
            {`${i + 1}`}<span aria-hidden="true">{' / 4'}</span>
          </p>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))
    }
  </div>
  <div class="scene-term">
    <figure class="term" aria-label="A terminal session: add a profile, sign in, save a secret, run an app">
      <div class="term-bar" aria-hidden="true">
        <i></i><i></i><i></i>
        <span>~/shop</span>
      </div>
      <pre class="term-body"><code>{
        timed.flat().map((l) => (
          <span
            class:list={['ln', `ln-${l.k}`]}
            data-s={l.s}
            style={`--tl: --s${l.s}; --r0: ${l.r0}%; --r1: ${l.r1}%; --n: ${l.n}`}
          >{l.k === 'cmd' ? <span class="ps">$ </span> : null}{l.k === 'ok' ? <span class="ok">✓ </span> : null}<span class="tx">{l.text}{(l.k === 'cmd' || l.k === 'cont') ? <span class="cur" aria-hidden="true"></span> : null}</span>{'\n'}</span>
        ))
      }<span class="ln ln-end" data-s="4" style="--tl: --s4; --r0: 59%; --r1: 60%"><span class="ps">$ </span><span class="blink" aria-hidden="true"></span></span></code></pre>
    </figure>
  </div>
</div>

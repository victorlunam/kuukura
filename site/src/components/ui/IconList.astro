---
// A list where each item leads with an icon: teal for what holds, muted for what does not.
import Icon from './Icon.astro';

type IconName = Parameters<typeof Icon>[0]['name'];
interface Props {
  /** `html` may hold <b> and <code>; it is trusted, written in this repository */
  items: readonly { icon: IconName; html: string }[];
  tone?: 'acc' | 'muted';
  columns?: 1 | 2;
}
const { items, tone = 'acc', columns = 1 } = Astro.props;
---

<ul class:list={['k-icons', `k-icons-${tone}`, columns === 2 && 'k-icons-2']}>
  {
    items.map((it) => (
      <li data-reveal>
        <Icon name={it.icon} size={tone === 'acc' ? 22 : 18} />
        <p set:html={it.html} />
      </li>
    ))
  }
</ul>

<style>
  .k-icons {
    list-style: none;
    margin: var(--k-space-6) 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem 3rem;
  }
  .k-icons-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    color: var(--k-muted);
  }
  p {
    margin: 0;
  }
  li :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }
  .k-icons-acc :global(svg) {
    color: var(--k-acc);
  }
  .k-icons-muted :global(svg) {
    color: var(--k-ink-2);
  }
  @media (max-width: 900px) {
    .k-icons-2 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

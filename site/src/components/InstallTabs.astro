---
// The three install commands, exactly as in docs/install.md and the README. Keyboard: arrows, Home, End.
interface Props {
  id: string;
}
const { id } = Astro.props;
const tabs = [
  { key: 'brew', label: 'Homebrew', cmd: 'brew install victorlunam/tap/kuukura' },
  {
    key: 'sh',
    label: 'macOS & Linux',
    cmd: 'curl -fsSL https://raw.githubusercontent.com/victorlunam/kuukura/main/scripts/install.sh | sh',
  },
  {
    key: 'ps',
    label: 'Windows',
    cmd: 'irm https://raw.githubusercontent.com/victorlunam/kuukura/main/scripts/install.ps1 | iex',
  },
];
---

<div class="install" data-tabs>
  <div class="install-bar">
    <div class="install-tabs" role="tablist" aria-label="Install the CLI with">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`${id}-tab-${t.key}`}
            aria-controls={`${id}-panel-${t.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {t.label}
          </button>
        ))
      }
    </div>
  </div>
  {
    tabs.map((t, i) => (
      <div
        class="install-panel"
        role="tabpanel"
        id={`${id}-panel-${t.key}`}
        aria-labelledby={`${id}-tab-${t.key}`}
        hidden={i !== 0}
      >
        <code>
          <span class="ps" aria-hidden="true">
            {t.key === 'ps' ? '>' : '$'}
          </span>
          <span class="install-cmd">{t.cmd}</span>
        </code>
        <button type="button" class="copy" data-copy={t.cmd} aria-label={`Copy the ${t.label} install command`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="i-copy">
            <rect x="9" y="9" width="12" height="12" rx="3" />
            <path d="M5 15V7a3 3 0 0 1 3-3h7" />
          </svg>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="i-done">
            <path d="m5 12.5 4.5 4.5L19 7" />
          </svg>
        </button>
      </div>
    ))
  }
</div>

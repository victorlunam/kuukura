---
import '~/styles/tokens.css';
import '~/styles/landing.css';
import Logo from '~/components/Logo.astro';
import { REPO, SITE } from '../../docs.config.mjs';

interface Props {
  title: string;
  description: string;
  /** No canonical link and noindex, for the 404 page. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const og = new URL('/brand/social-preview.png', SITE).href;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#061215" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kuukura" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="kuukura: secrets for your team. Self-hosted. Decrypted only on your server." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="nav-in">
        <a class="nav-logo" href="/" aria-label="kuukura home"><Logo height={26} /></a>
        <nav aria-label="Main">
          <ul>
            <li class="nav-hide"><a href="/#how">How it works</a></li>
            <li class="nav-hide"><a href="/#security">Security</a></li>
            <li class="nav-hide"><a href="/#deploy">Deploy</a></li>
            <li><a href="/docs/">Docs</a></li>
            <li>
              <a class="nav-gh" href={REPO} aria-label="kuukura on GitHub">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
                  ><path
                    fill="currentColor"
                    d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
                  ></path></svg
                >
              </a>
            </li>
            <li><a class="btn btn-sm btn-primary" href="/docs/install/">Get started</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-in">
        <div class="foot-brand">
          <Logo height={24} />
          <p>A self-hosted secrets vault for small teams. MIT licensed. Copyright © 2026 Victor Luna.</p>
        </div>
        <nav aria-label="Footer">
          <ul>
            <li><a href="/docs/">Docs</a></li>
            <li><a href="/docs/install/">Install</a></li>
            <li><a href="/docs/deploy/">Deploy</a></li>
            <li><a href="/docs/security/">Security</a></li>
            <li><a href="/docs/changelog/">Changelog</a></li>
            <li><a href={`${REPO}/blob/main/LICENSE`}>License</a></li>
            <li><a href={REPO}>GitHub</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      import '~/scripts/landing';
    </script>
  </body>
</html>

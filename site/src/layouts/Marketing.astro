---
// The marketing layout: head and meta, skip link, the sticky nav and the footer. Dark only.
import '~/styles/tokens.css';
import '~/styles/base.css';
import '~/styles/motion.css';
import Logo from '~/components/ui/Logo.astro';
import Button from '~/components/ui/Button.astro';
import { REPO_URL, SITE } from '../../site.config.mjs';

interface Props {
  title: string;
  description: string;
  /** no canonical link and noindex, for the 404 page */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const og = new URL('/brand/social-preview.png', SITE).href;
const footer = [
  { href: '/docs/', label: 'Docs' },
  { href: '/docs/install/', label: 'Install' },
  { href: '/docs/deploy/', label: 'Deploy' },
  { href: '/docs/security/', label: 'Security' },
  { href: '/docs/changelog/', label: 'Changelog' },
  { href: `${REPO_URL}/blob/main/LICENSE`, label: 'License' },
  { href: REPO_URL, label: 'GitHub' },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#061215" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kuukura" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="kuukura: secrets for your team. Self-hosted. Decrypted only on your server." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="bar">
        <a class="home" href="/" aria-label="kuukura home"><Logo height={26} /></a>
        <nav aria-label="Main">
          <ul>
            <li class="wide"><a href="/#how">How it works</a></li>
            <li class="wide"><a href="/#security">Security</a></li>
            <li class="wide"><a href="/#deploy">Deploy</a></li>
            <li><a href="/docs/">Docs</a></li>
            <li>
              <a class="gh" href={REPO_URL} aria-label="kuukura on GitHub">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
                  ><path
                    fill="currentColor"
                    d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
                  ></path></svg
                >
              </a>
            </li>
            <li><Button href="/docs/install/" size="sm">Get started</Button></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="bar foot-in">
        <div class="foot-brand">
          <Logo height={24} />
          <p>A self-hosted secrets vault for small teams. MIT licensed. Copyright © 2026 Victor Luna.</p>
        </div>
        <nav aria-label="Footer">
          <ul>{footer.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      </div>
    </footer>
    <script>
      import '~/scripts/motion';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--k-ink);
    color: var(--k-bg);
    padding: 0.6rem 1rem;
    border-radius: var(--k-radius-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .skip:focus {
    top: 0.75rem;
  }
  .bar {
    max-width: calc(var(--k-maxw) + 2 * var(--k-gutter));
    margin-inline: auto;
    padding-inline: var(--k-gutter);
  }
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(6, 18, 21, 0.72);
    backdrop-filter: saturate(1.6) blur(18px);
    -webkit-backdrop-filter: saturate(1.6) blur(18px);
    border-bottom: 1px solid rgba(233, 243, 242, 0.07);
  }
  .nav .bar {
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--k-space-4);
  }
  .home,
  .foot-brand {
    color: var(--k-ink);
    border-radius: 8px;
  }
  ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav ul {
    gap: clamp(0.75rem, 2.2vw, 1.75rem);
  }
  .nav a:not(.k-btn),
  .foot a {
    color: var(--k-muted);
    text-decoration: none;
    font-size: var(--k-text-sm);
    font-weight: 500;
    transition: color var(--k-dur-fast) ease;
  }
  .nav a:not(.k-btn):hover,
  .foot a:hover {
    color: var(--k-ink);
  }
  .gh {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
  }
  .foot {
    border-top: 1px solid var(--k-line);
    padding-block: 3rem 3.5rem;
    color: var(--k-muted);
    font-size: var(--k-text-sm);
  }
  .foot-in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }
  .foot-brand p {
    margin: 0.9rem 0 0;
    color: var(--k-muted);
    max-width: 24rem;
  }
  .foot ul {
    gap: 0.75rem 1.5rem;
  }
  @media (max-width: 760px) {
    .wide {
      display: none;
    }
  }
</style>

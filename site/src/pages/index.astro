---
// The landing page. Every claim here is checked against the repository (README, docs/, SECURITY.md, the CLI help).
import { Picture } from 'astro:assets';
import Landing from '~/layouts/Landing.astro';
import InstallTabs from '~/components/InstallTabs.astro';
import Vault from '~/components/Vault.astro';
import TerminalScene from '~/components/TerminalScene.astro';
import Diagram from '~/components/Diagram.astro';
import Icon from '~/components/Icon.astro';
import stepup from '~/assets/screens/stepup-dark.webp';
import invite from '~/assets/screens/invite-dark.webp';
import enroll from '~/assets/screens/enroll-dark.webp';
import done from '~/assets/screens/done-dark.webp';
import { REPO } from '../../docs.config.mjs';

const features = [
  {
    icon: 'envelope',
    title: 'A fresh key for every version.',
    body: 'Envelope encryption: each secret version gets its own AES-256-GCM data key, and the master key wraps the data keys.',
  },
  {
    icon: 'people',
    title: 'Least privilege by default.',
    body: 'Read and write grants per tag, and groups. Admins manage people but have no secret access by role.',
  },
  {
    icon: 'machine',
    title: 'CI without shared passwords.',
    body: 'Machine tokens are limited by their own grants and their owner’s, and can never reveal a value.',
  },
  {
    icon: 'chain',
    title: 'A log you can check.',
    body: 'Insert-only and hash-chained. <code>ku-server audit verify</code> detects edited or removed rows in the middle of the chain.',
  },
  {
    icon: 'terminal',
    title: 'Guard rails in the CLI.',
    body: '<code>ku run</code> injects environment variables and refuses names that load code, such as <code>LD_PRELOAD</code>. Values are never arguments.',
  },
  {
    icon: 'key',
    title: 'Your master key, your choice.',
    body: 'From a file or Docker secret, an environment variable, or AWS KMS. It is never in the database, and <code>key show</code> prints it once per version for your backup.',
  },
  {
    icon: 'lifebuoy',
    title: 'Lost your passkey? Recover.',
    body: 'Ten recovery codes at enrollment. Lost those too? <code>ku-server user reset-factors</code> on the host prints a new 15-minute link.',
  },
  {
    icon: 'shield',
    title: 'Releases you can verify.',
    body: 'A macOS CLI signed with a Developer ID (not notarized). A multi-arch image with build provenance, a keyless cosign signature and an SBOM.',
  },
] as const;

const claims = [
  { claim: 'Threats, controls and what is not defended', where: 'Threat model', href: '/docs/threat-model/' },
  {
    claim: 'Self-review against OWASP ASVS 5.0.0 Level 2, a draft checklist with its open items listed',
    where: 'ASVS L2 self-review',
    href: '/docs/asvs-l2/',
  },
  { claim: 'Private vulnerability reporting, response targets and scope', where: 'Security policy', href: '/docs/security/' },
  { claim: 'Releases come from this repository’s workflow', where: 'Verifying a release', href: '/docs/deploy/#verifying-a-release' },
  { claim: 'The audit log is a hash chain', where: 'ku-server audit verify', href: '/docs/cli/#ku-server', code: true },
  {
    claim: 'Static analysis and dependency checks in CI (staticcheck, gosec, govulncheck)',
    where: 'ci.yml',
    href: `${REPO}/blob/main/.github/workflows/ci.yml`,
    code: true,
  },
];

const notProtected = [
  ['Someone with both the database and the master key', 'reads everything. That is why the key lives outside the database and /data.'],
  ['A compromised server host.', 'Root access, a debugger or a memory dump exposes keys and plaintext while the server runs.'],
  ['A malicious admin with host or database access,', 'who can mint invites, replace the binary or rewrite the audit chain.'],
  ['A stolen session on an unlocked laptop', 'can ku run plain secrets until it expires (8 hours, 1 hour idle). Reveals still need your second factor.'],
  ['AI agents that print what ku run injects.', 'Give agents low-value development secrets only.'],
  ['Phishing of authenticator codes and recovery codes,', 'which passkeys resist and these do not.'],
];

const targets = [
  { name: 'Docker Compose + Caddy', href: '/docs/templates/#docker-compose--caddy-any-vps' },
  { name: 'Dokploy', href: '/docs/templates/#dokploy-compose' },
  { name: 'Coolify', href: '/docs/templates/#coolify' },
  { name: 'Render', href: '/docs/templates/#render' },
  { name: 'Docker Swarm', href: '/docs/templates/#docker-swarm--portainer-stack' },
  { name: 'docker run', href: '/docs/deploy/#deploy-targets' },
];

const compare = [
  {
    name: 'kuukura',
    hosting: 'Self-hosted, one organization',
    strengths: 'Small, simple model; server-side decryption with per-person confirmation; no unseal step',
    when: 'You are one small team and want a vault you can operate in an afternoon',
  },
  {
    name: 'Infisical',
    href: 'https://github.com/Infisical/infisical',
    hosting: 'Self-hosted or cloud',
    strengths: 'MIT core; dynamic secrets listed among its features; paid enterprise edition under ee',
    when: 'You want a broader platform and can use its enterprise tier where needed',
  },
  {
    name: 'OpenBao',
    href: 'https://github.com/openbao/openbao',
    hosting: 'Self-hosted',
    strengths: 'MPL-2.0; dynamic secrets with leases and revocation; encrypts before writing to storage',
    when: 'You need dynamic credentials, many backends or large-scale policy',
  },
  {
    name: 'SOPS',
    href: 'https://github.com/getsops/sops',
    hosting: 'A file tool, no server',
    strengths: 'MPL-2.0; encrypts YAML, JSON, ENV, INI and binary files; AWS/GCP/Azure KMS, age, PGP',
    when: 'Your secrets live in Git and you do not need access logs or per-person grants',
  },
  {
    name: '.env files',
    hosting: 'None',
    strengths: 'Zero setup',
    when: 'Throwaway local work with nothing worth protecting',
  },
];

const faq = [
  {
    q: 'Why not Vault or OpenBao?',
    a: 'They do more, including dynamic secrets, and cost more to run. kuukura trades breadth for a small system you can understand and operate, with no unseal ceremony. If you need their features, use them.',
  },
  {
    q: 'What if I lose my passkey?',
    a: 'Use a recovery code (you get ten at enrollment). If you lost those too, someone with a shell on the server runs <code>ku-server user reset-factors you@example.com</code> and you enroll again through a 15-minute link.',
  },
  {
    q: 'How do I back up?',
    a: 'Back up the database (the <code>/data</code> volume or Postgres) and the master key as two different things in two different places. Run <code>ku-server key show</code> once per key version and keep the text in a password manager; the key file lives in its own <code>/keys</code> volume.',
  },
  {
    q: 'Can an AI agent see values?',
    a: 'Not through the commands it is taught: <code>ku run</code> injects them, and reveals need your passkey or code. But a command it runs can print its own environment. Treat that as accepted risk and use low-value secrets (<a href="/docs/agents/">details</a>).',
  },
  {
    q: 'What if the server is down?',
    a: '<code>ku run</code> cannot fetch secrets until it is back, because values are decrypted only on the server. The server restarts by reading the key again; there is nothing to unseal. Run it as a restartable container with its volumes backed up.',
  },
  { q: 'Is there a hosted version?', a: 'No. You run it yourself.' },
  { q: 'Can several organizations share one instance?', a: 'No. It is one instance per organization.' },
  {
    q: 'Can I use Postgres?',
    a: 'Yes: set <code>VAULT_STORAGE=postgres</code>. The audit log is insert-only, enforced with database grants (<a href="/docs/deploy/#3-database">setup</a>). SQLite is the default.',
  },
];
---

<Landing
  title="kuukura: a self-hosted secrets vault for small teams"
  description="kuukura is an open-source, self-hosted secrets vault for small teams. Values are decrypted only on your server, reveals are confirmed with your passkey or authenticator app, and every read is audited."
>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <p class="eyebrow hero-eyebrow">Open source · Self-hosted · MIT</p>
      <h1 id="hero-title" class="display">
        <span>Secrets for your team.</span>
        <span class="muted-line">Decrypted only on your server.</span>
      </h1>
      <p class="lede hero-lede">
        kuukura is a small vault you run yourself. <b>Reveals are confirmed with your passkey</b> or authenticator
        app, and <b>every read is recorded</b> in a tamper-evident log.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/docs/install/">Get started</a>
        <a class="btn btn-ghost" href={REPO}>View on GitHub</a>
      </div>
      <div class="hero-install">
        <InstallTabs id="hero" />
        <p class="fine">
          Installs <code>ku</code> and <code>kuukura</code> (the same program). Then: <a href="/docs/deploy/">deploy the server</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- the vault opens -->
  <section class="stage" aria-label="The vault">
    <div class="stage-pin">
      <div class="stage-copy">
        <p class="stage-line stage-a">Every secret is sealed with its own key.</p>
        <p class="stage-line stage-b">Opened only on your server, and only for who you grant.</p>
      </div>
      <Vault />
    </div>
  </section>

  <!-- 2. The problem -->
  <section class="section problem" aria-labelledby="problem-title">
    <div class="wrap">
      <p class="eyebrow" id="problem-title">Why kuukura</p>
      <div class="problem-lines">
        <p class="pl"><code>.env</code> files passed around in chat.</p>
        <p class="pl">API keys in a shared password manager.</p>
        <p class="pl">A heavyweight vault with seal, unseal and a policy language.</p>
        <p class="pl">And nobody can say who read what last week.</p>
      </div>
      <p class="answer">
        kuukura is one small server, one database and three ideas:
        <span class="answer-em">tags, grants and people.</span>
      </p>
      <p class="lede answer-lede">You run it, you hold the keys, and every read lands in a tamper-evident log.</p>
    </div>
  </section>

  <!-- 3. The session -->
  <section class="section session" aria-labelledby="session-title">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow">Five commands</p>
        <h2 id="session-title" class="h2">Hand a secret to a program without handing it to a person.</h2>
      </header>
      <TerminalScene />
    </div>
  </section>

  <!-- 4. How it works -->
  <section class="section how" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <header class="sec-head center">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title" class="h2">The CLI is a channel.<br />The server holds the keys.</h2>
        <p class="lede">
          Your server checks the grant, decrypts, and writes the decision to the audit log. The database only ever holds
          ciphertext and wrapped keys.
        </p>
      </header>
      <Diagram />
      <ul class="how-notes">
        <li><b>Envelope encryption.</b> A fresh AES-256-GCM data key for every secret version.</li>
        <li><b>The master key is not in the database.</b> A file or Docker secret, an environment variable, or AWS KMS.</li>
        <li><b>No unseal step.</b> The server reads the key at start and refuses a key that cannot open the data.</li>
      </ul>
    </div>
  </section>

  <!-- 5. The confirmation moment -->
  <section class="section confirm" aria-labelledby="confirm-title">
    <div class="wrap confirm-in">
      <div class="phone" data-reveal>
        <div class="phone-frame">
          <Picture
            src={stepup}
            formats={['avif', 'webp']}
            widths={[390, 780]}
            sizes="(min-width: 960px) 360px, 72vw"
            alt="The confirmation page on vault.example.com: Confirm it's you. A command in your terminal is asking you to confirm: Reveal STRIPE_KEY app:shop env:prod. Buttons: Confirm with your passkey, or a 6-digit code from your authenticator app."
            loading="lazy"
          />
        </div>
      </div>
      <div class="confirm-copy">
        <p class="eyebrow">The confirmation moment</p>
        <h2 id="confirm-title" class="h2">A reveal needs you. Not just your session.</h2>
        <p class="lede">
          Revealing a value, saving it to a file or turning confirmation off opens a page on your own server. It shows
          exactly what you are confirming, then asks for your passkey or a code from your authenticator app.
        </p>
        <ul class="checks">
          <li><Icon name="fingerprint" size={22} /><span><b>Passkeys with user verification,</b> or an authenticator app.</span></li>
          <li><Icon name="check" size={22} /><span><b>Single use and 60 seconds,</b> bound to you, the action and the secrets.</span></li>
          <li><Icon name="machine" size={22} /><span><b>Machines never confirm.</b> A CI token can never reveal a value, and an agent cannot give your passkey.</span></li>
          <li>
            <Icon name="key" size={22} /><span
              ><b>Mark a secret <code>requires_authorize</code></b> and even <code>ku run</code> asks first.</span
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="wrap flow">
      <p class="flow-title">What your team sees, from invite to done</p>
      <ol class="flow-list" tabindex="0" aria-label="The four pages, in order">
        {
          [
            { img: invite, t: 'The invitation', alt: "The invitation page: You're invited. Sign in with Google." },
            { img: enroll, t: 'Add a passkey', alt: 'Secure your account: add a passkey, or use an authenticator app.' },
            { img: stepup, t: 'Confirm', alt: "Confirm it's you: Reveal STRIPE_KEY app:shop env:prod." },
            { img: done, t: 'All set', alt: "You're all set: your account is ready. In your terminal, add this server and sign in." },
          ].map((s, i) => (
            <li data-reveal style={`--i: ${i}`}>
              <Picture src={s.img} formats={['avif', 'webp']} widths={[240, 480]} sizes="(min-width: 960px) 220px, 46vw" alt={s.alt} loading="lazy" />
              <span><b>{i + 1}</b>{s.t}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Features -->
  <section class="section features" aria-labelledby="features-title">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow">What you get</p>
        <h2 id="features-title" class="h2">Small enough to understand.<br />Strict where it counts.</h2>
      </header>
      <ul class="cards">
        {
          features.map((f, i) => (
            <li class="card" data-reveal style={`--i: ${i % 4}`}>
              <span class="card-icon">
                <Icon name={f.icon} size={22} />
              </span>
              <h3>{f.title}</h3>
              <p set:html={f.body} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. Agents -->
  <section class="section agents" aria-labelledby="agents-title">
    <div class="wrap agents-in">
      <div class="agents-copy">
        <p class="eyebrow">Built for AI coding agents</p>
        <h2 id="agents-title" class="h2">Let agents use secrets without handing them over.</h2>
        <p class="lede">
          Add <code>SKILL.md</code> to your agent. It teaches <code>ku run</code> and <code>ku secret list</code>, and
          what never to do: no reveals, no printing values, no values in commands or files.
        </p>
        <aside class="note" aria-label="Accepted risk">
          <Icon name="info" size={20} />
          <p>
            <b>The honest limit.</b> A command an agent runs can print its own environment. Give agents low-value
            development secrets, mark sensitive ones <code>requires_authorize</code>, and rotate on leak.
            <a href="/docs/agents/">Read the agent guide</a>
          </p>
        </aside>
      </div>
      <figure class="skill" data-reveal aria-label="An excerpt of SKILL.md">
        <div class="skill-bar"><Icon name="doc" size={16} /><span>SKILL.md</span></div>
        <div class="skill-body">
          <p class="skill-quote">Secrets live in a vault. You run commands <em>with</em> them; you never read them.</p>
          <p class="skill-h">Do</p>
          <ul>
            <li><code>ku secret list app:shop env:dev</code><span>names, versions and tags, never values</span></li>
            <li><code>ku run env:dev -- npm run dev</code><span>secrets injected as env vars</span></li>
            <li><span>If a secret is blocked or you are not permitted, stop and tell the user.</span></li>
          </ul>
          <p class="skill-h skill-never">Never</p>
          <ul>
            <li><code>ku secret get --reveal</code><span>or <code>--out</code>: they need the user’s own confirmation</span></li>
            <li><span>Print, echo, log or paste a secret value anywhere.</span></li>
            <li><span>Put a value in a command line, a URL, a config file or a test fixture.</span></li>
          </ul>
        </div>
        <figcaption><a href="/docs/skill/">The full skill</a></figcaption>
      </figure>
    </div>
  </section>

  <!-- 8. Security, honestly -->
  <section class="section security" id="security" aria-labelledby="security-title">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow">Security, honestly</p>
        <h2 id="security-title" class="h2">Every claim comes with a place to check it.</h2>
        <p class="lede">These are self-reviews and published evidence, not third-party certifications.</p>
      </header>
      <ul class="claims">
        {
          claims.map((c) => (
            <li data-reveal>
              <span class="claim">{c.claim}</span>
              <a href={c.href} class="claim-link">
                {c.code ? <code>{c.where}</code> : c.where}
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="verify" data-reveal>
        <p class="verify-t">Check what you pull. Set <code>v</code> to the release you run.</p>
        <pre tabindex="0" aria-label="Release verification commands"><code><span class="c">v=YEAR.MONTH.N</span>
gh attestation verify oci://ghcr.io/victorlunam/kuukura:$v --repo victorlunam/kuukura
cosign verify ghcr.io/victorlunam/kuukura:$v \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com \
  --certificate-identity https://github.com/victorlunam/kuukura/.github/workflows/release.yml@refs/tags/v$v</code></pre>
        <p class="fine">These prove an artifact came from this repository’s workflow at that tag; they do not prove the source has no bugs.</p>
      </div>
      <div class="nope">
        <h3 class="h3">What kuukura does not protect against</h3>
        <ul>
          {
            notProtected.map(([a, b]) => (
              <li data-reveal>
                <Icon name="x" size={18} />
                <p>
                  <b>{a}</b> {b}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 9. Deploy -->
  <section class="section deploy" id="deploy" aria-labelledby="deploy-title">
    <div class="wrap deploy-in">
      <div class="deploy-copy">
        <p class="eyebrow">Deploy</p>
        <h2 id="deploy-title" class="h2">Runs anywhere you run Docker.</h2>
        <p class="lede">
          One container and the published image. <b>SQLite by default</b>, Postgres when you want it. Nothing is built on
          your server.
        </p>
        <ul class="badges" aria-label="Templates">
          {
            targets.map((t) => (
              <li>
                <a href={t.href}>{t.name}</a>
              </li>
            ))
          }
        </ul>
        <div class="cta-row">
          <a class="btn btn-ghost" href="https://render.com/deploy?repo=https://github.com/victorlunam/kuukura">Deploy to Render</a>
          <a class="btn btn-link" href="/docs/deploy/">Read the deploy guide</a>
        </div>
      </div>
      <figure class="code-card" data-reveal>
        <div class="skill-bar"><Icon name="terminal" size={16} /><span>Docker Compose + Caddy, on any VPS</span></div>
        <pre tabindex="0" aria-label="Deploy commands"><code><span class="c"># a domain on a Linux host with Docker, and a Google OAuth client</span>
mkdir kuukura && cd kuukura
curl -fsSLO https://raw.githubusercontent.com/victorlunam/kuukura/main/deploy/docker/docker-compose.yml
curl -fsSL https://raw.githubusercontent.com/victorlunam/kuukura/main/deploy/docker/.env.example -o .env
<span class="c"># edit .env: VAULT_DOMAIN, VAULT_OIDC_CLIENT_ID, and for production KUUKURA_VERSION</span>

mkdir -p secrets
docker run --rm -v "$PWD/secrets:/s" ghcr.io/victorlunam/kuukura key init --key-file /s/master_key
printf '%s' 'your-google-oauth-client-secret' > secrets/oidc_client_secret
<span class="c"># on Linux hosts the container runs as user 65532: see "File permissions" in the guide</span>

docker compose up -d
docker compose exec kuukura /ku-server user invite you@example.com --admin
docker compose exec -it kuukura /ku-server key show</code></pre>
        <figcaption>
          Back up the master key right away: without it nobody, including the maintainer, can read your data.
          {' '}<a href="/docs/deploy/">The full steps</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 10. Comparison -->
  <section class="section compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow">How it compares</p>
        <h2 id="compare-title" class="h2">Choose the right tool. Even if it isn’t this one.</h2>
      </header>
      <div class="table-wrap">
        <table class="cmp">
          <thead>
            <tr><th scope="col"><span class="sr-only">Tool</span></th><th scope="col">Hosting</th><th scope="col">Strengths</th><th scope="col">Choose it if</th></tr>
          </thead>
          <tbody>
            {
              compare.map((r) => (
                <tr class:list={{ self: r.name === 'kuukura' }}>
                  <th scope="row">{r.href ? <a href={r.href}>{r.name}</a> : r.name === '.env files' ? <code>.env</code> : r.name}{r.name === '.env files' ? ' files' : ''}</th>
                  <td data-label="Hosting">{r.hosting}</td>
                  <td data-label="Strengths">{r.strengths}</td>
                  <td data-label="Choose it if">{r.when}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="fine sources">
        Sources, last checked 2026-10-19: the repository pages linked above (licenses and feature lists as stated by each
        project). Doppler is not listed because its self-hosting status could not be confirmed from its public pages.
        {' '}<a href={`${REPO}/issues`}>Open an issue</a> if a row is out of date.
      </p>
    </div>
  </section>

  <!-- 11. Open source -->
  <section class="section oss" aria-labelledby="oss-title">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow">Open source</p>
        <h2 id="oss-title" class="h2">MIT licensed. One maintainer. No surprises.</h2>
      </header>
      <ul class="oss-grid">
        <li data-reveal style="--i: 0">
          <h3>MIT license</h3>
          <p>Use it, read it, change it. There is no hosted version: you run it yourself.</p>
          <a href={`${REPO}/blob/main/LICENSE`}>License</a>
        </li>
        <li data-reveal style="--i: 1">
          <h3>Calendar versions</h3>
          <p>Releases are <code>YEAR.MONTH.N</code>. Pin one in production and read the notes before upgrading.</p>
          <a href="/docs/changelog/">Changelog</a>
        </li>
        <li data-reveal style="--i: 2">
          <h3>Contributions welcome</h3>
          <p>Issues and pull requests are welcome. A short issue before a large change saves everyone time.</p>
          <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        </li>
        <li data-reveal style="--i: 3">
          <h3>Report privately</h3>
          <p>Found a vulnerability? Use GitHub’s private vulnerability reporting, not a public issue.</p>
          <a href="/docs/security/">Security policy</a>
        </li>
      </ul>
      <p class="fine status">
        Not yet: SSO/SAML, dynamic secrets, multi-organization instances, a third-party security audit, and a full
        requirement-by-requirement ASVS mapping.
      </p>
    </div>
  </section>

  <!-- 12. FAQ -->
  <section class="section faq" aria-labelledby="faq-title">
    <div class="wrap faq-in">
      <h2 id="faq-title" class="h2">Questions</h2>
      <div class="faq-list">
        {
          faq.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 9.5 12 15.5 18 9.5" /></svg>
              </summary>
              <p set:html={f.a} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- final call to action -->
  <section class="section final" aria-labelledby="final-title">
    <div class="wrap final-in">
      <div class="final-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="88" height="88" fill="none">
          <rect width="64" height="64" rx="14" fill="#0E2A30"></rect>
          <rect x=".5" y=".5" width="63" height="63" rx="13.5" stroke="#EAF4F2" stroke-opacity=".14"></rect>
          <circle cx="32" cy="32" r="20" stroke="#EAF4F2" stroke-width="4.5"></circle>
          <path class="final-bolts" d="M32 20.5h0M32 43.5h0M20.5 32h0M43.5 32h0M23.87 23.87h0M40.13 23.87h0M23.87 40.13h0M40.13 40.13h0" stroke="#EAF4F2" stroke-width="4.2" stroke-linecap="round"></path>
          <circle cx="32" cy="32" r="4.6" fill="#F5A524"></circle>
        </svg>
      </div>
      <h2 id="final-title" class="display final-title">A vault you can operate in an afternoon.</h2>
      <div class="cta-row center">
        <a class="btn btn-primary" href="/docs/install/">Get started</a>
        <a class="btn btn-ghost" href="/docs/">Read the docs</a>
      </div>
      <div class="final-install">
        <InstallTabs id="final" />
      </div>
    </div>
  </section>
</Landing>

---
import Marketing from '~/layouts/Marketing.astro';
import Section from '~/components/ui/Section.astro';
import Heading from '~/components/ui/Heading.astro';
import Button from '~/components/ui/Button.astro';
import emptyVault from '~/generated/art/vault-empty.svg?raw';

// The product's empty-vault illustration without its own <style>: the page themes its classes with the tokens.
const art = emptyVault
  .replace(/<style>[\s\S]*?<\/style>/, '')
  .replace(/role="img"[^>]*?aria-label="[^"]*"/, 'aria-hidden="true"');
---

<Marketing title="Page not found · kuukura" description="This page does not exist." noindex>
  <Section class="nf">
    <div class="stack">
      <div class="art" set:html={art} />
      <Heading id="nf-title" level={1} eyebrow="404" align="center" gap={false}>
        This vault is empty.
        <Fragment slot="lede">The page you asked for is not here. It may have moved when the docs were reorganized.</Fragment>
      </Heading>
      <div class="ctas">
        <Button href="/">Go to the home page</Button>
        <Button href="/docs/" variant="ghost">Open the docs</Button>
      </div>
    </div>
  </Section>
</Marketing>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .art {
    width: min(22rem, 80vw);
    margin-bottom: 2rem;
  }
  .art :global(svg) {
    width: 100%;
    height: auto;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--k-space-3);
    margin-top: var(--k-space-6);
  }
  /* the illustration's classes (brand.md: each art file themes .s-* and .f-*) */
  .art :global(.s-ink) {
    stroke: var(--k-ink);
  }
  .art :global(.f-ink) {
    fill: var(--k-ink);
  }
  .art :global(.f-card) {
    fill: var(--k-card);
  }
  .art :global(.f-soft) {
    fill: var(--k-soft);
  }
  .art :global(.f-hollow) {
    fill: var(--k-hollow);
  }
  .art :global(.f-acc) {
    fill: var(--k-acc);
  }
  .art :global(.f-amber) {
    fill: var(--k-amber);
  }
</style>

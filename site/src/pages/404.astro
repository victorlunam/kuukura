---
import Landing from '~/layouts/Landing.astro';
import emptyVault from '~/generated/art/vault-empty.svg?raw';

// The empty-vault illustration from the product, without its own <style>; the page CSS themes its classes.
const art = emptyVault.replace(/<style>[\s\S]*?<\/style>/, '').replace(/role="img"[^>]*?aria-label="[^"]*"/, 'aria-hidden="true"');
---

<Landing title="Page not found · kuukura" description="This page does not exist." noindex>
  <section class="section nf">
    <div class="wrap nf-in">
      <div class="nf-art" set:html={art} />
      <p class="eyebrow">404</p>
      <h1 class="h2">This vault is empty.</h1>
      <p class="lede">The page you asked for is not here. It may have moved when the docs were reorganized.</p>
      <div class="cta-row center">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href="/docs/">Open the docs</a>
      </div>
    </div>
  </section>
</Landing>

<style>
  .nf {
    min-height: calc(100svh - 3.5rem - 10rem);
    display: grid;
    align-items: center;
    text-align: center;
  }
  .nf-in {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .nf .lede {
    margin-inline: auto;
  }
  .nf-art {
    width: min(22rem, 80vw);
    margin-bottom: 2rem;
  }
  .nf-art :global(svg) {
    width: 100%;
    height: auto;
  }
  .nf-art :global(.s-ink) {
    stroke: var(--k-ink);
  }
  .nf-art :global(.f-ink) {
    fill: var(--k-ink);
  }
  .nf-art :global(.f-card) {
    fill: var(--k-card);
  }
  .nf-art :global(.f-soft) {
    fill: var(--k-soft);
  }
  .nf-art :global(.f-hollow) {
    fill: var(--k-hollow);
  }
  .nf-art :global(.f-acc) {
    fill: var(--k-acc);
  }
  .nf-art :global(.f-amber) {
    fill: var(--k-amber);
  }
</style>

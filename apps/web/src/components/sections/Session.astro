---
// A real session, typed as you scroll: each caption drives its lines. Commands and output are the CLI's own
// (apps/ku); the URL and names are the docs' fake examples, and the value never appears: the prompt echoes bullets.
// On phones nothing is pinned: the terminal is whole, then the four steps.
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Terminal from '../ui/Terminal.astro';
import type { TermLine } from '../ui/Terminal.astro';

type Line = Omit<TermLine, 'step' | 'style'>;
const steps: { title: string; body: string; lines: Line[] }[] = [
  {
    title: 'Point it at your server.',
    body: 'A profile is a name and the address of your vault. Nothing secret is stored in it.',
    lines: [
      { k: 'cmd', text: 'ku profile add work \\' },
      { k: 'cont', text: '    --url https://vault.example.com' },
      { k: 'ok', text: 'Added profile work' },
    ],
  },
  {
    title: 'Sign in with Google, then your passkey.',
    body: 'A passkey or authenticator app is required on every sign-in. The session is kept in your system keychain for 8 hours, 1 hour idle.',
    lines: [
      { k: 'cmd', text: 'ku login' },
      { k: 'out', text: 'profile: work' },
      { k: 'out', text: 'Opening your browser to sign in.' },
      { k: 'ok', text: 'Signed in to work' },
    ],
  },
  {
    title: 'Save a value. Never as an argument.',
    body: 'It comes from a hidden prompt, so it stays out of your shell history and the process list. The server encrypts it under a fresh data key.',
    lines: [
      { k: 'cmd', text: 'ku secret set DATABASE_URL app:shop' },
      { k: 'out', text: 'Value (hidden): ••••••••••••••••' },
      { k: 'out', text: 'DATABASE_URL is new. Create it? (y/N) y' },
      { k: 'ok', text: 'Saved DATABASE_URL (version 1)' },
    ],
  },
  {
    title: 'Run your app with its secrets.',
    body: 'Link the folder to an app once. ku run starts your command with the secrets you may read in its environment, and passes its output and exit code through.',
    lines: [
      { k: 'cmd', text: 'ku link shop' },
      { k: 'ok', text: 'Linked this folder to shop' },
      { k: 'cmd', text: 'ku run -- npm start' },
      { k: 'out', text: '> shop@1.0.0 start' },
      { k: 'out', text: '> node server.js' },
      { k: 'out', text: 'listening on :3000' },
    ],
  },
];

// Each step's lines are spread over the middle of its caption's pass through the viewport, weighted by length. The
// first command is always on screen, so the terminal is never blank.
const FROM = 30;
const TO = 55;
const typed = (l: Line) => l.k === 'cmd' || l.k === 'cont';
const lines: TermLine[] = steps.flatMap((step, si) => {
  const weight = step.lines.map((l) => (typed(l) ? l.text.length : 6));
  const total = weight.reduce((a, b) => a + b, 0);
  let at = FROM;
  return step.lines.map((l, i): TermLine => {
    if (si === 0 && typed(l)) return l;
    const r0 = at;
    at += ((TO - FROM) * (weight[i] ?? 0)) / total;
    return { ...l, step: si + 1, style: `--tl: --s${si + 1}; --r0: ${r0.toFixed(2)}%; --r1: ${at.toFixed(2)}%; --n: ${l.text.length}` };
  });
});
lines.push({ k: 'end', text: '', step: 4, style: '--tl: --s4; --r0: 60%' });
---

<Section id="session" class="session" aria-labelledby="session-title">
  <Heading id="session-title" eyebrow="Four steps">Hand a secret to a program without handing it to a person.</Heading>
  <div class="scene" data-steps>
    <div class="term">
      <Terminal title="~/shop" label="A terminal session: add a profile, sign in, save a secret, run an app" lines={lines} />
    </div>
    <ol class="captions">
      {
        steps.map((s, i) => (
          <li class="caption" data-step-caption={i + 1} style={`view-timeline-name: --s${i + 1}; --cap: --s${i + 1}`}>
            <p class="n">
              <span class="sr-only">Step </span>
              {`${i + 1}`}
              <span aria-hidden="true">{' / 4'}</span>
            </p>
            <h3 data-focus>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  .scene {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    timeline-scope: --s1, --s2, --s3, --s4;
  }
  /* the terminal stays while the captions pass; it sits on the left, the captions on the right */
  .term {
    position: sticky;
    top: max(5rem, calc(50vh - 11rem));
  }
  .captions {
    list-style: none;
    margin: 0;
    padding: 0 0 8vh;
  }
  .caption {
    min-height: 40vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 26rem;
    view-timeline-axis: block;
  }
  .n {
    margin: 0 0 var(--k-space-3);
    font: 600 var(--k-text-sm) / 1 var(--k-mono);
    color: var(--k-muted);
  }
  h3 {
    margin: 0;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .caption p:last-child {
    margin: var(--k-space-4) 0 0;
    color: var(--k-muted);
  }
  /* tablet and phone: no pinning. The terminal is whole, then the four steps one under the other */
  @media (max-width: 900px) {
    .scene {
      grid-template-columns: minmax(0, 1fr);
    }
    .term {
      position: static;
    }
    .captions {
      display: grid;
      gap: var(--k-space-6);
      padding: var(--k-space-6) 0 0;
    }
    .caption {
      min-height: 0;
      max-width: none;
    }
  }
</style>
